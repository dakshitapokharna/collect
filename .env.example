# Copy this file to ".env" and put your own Sarvam API key below.
# Get a key from the Sarvam dashboard: https://dashboard.sarvam.ai
# Never commit your real .env (it is already in .gitignore).
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: override the chat model (default: sarvam-105b-conversations)
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
